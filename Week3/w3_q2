 #include <iostream>

#include <vector>
#include <algorithm>
using namespace std;

// Check if we can produce at least t items in given time
bool can_produce(const vector<int>& machines, int time, int t) {
    int total = 0;
    for (int k : machines) {
        total += time / k;
        if (total >= t) return true; // early stopping
    }
    return false;
}

int main() {
    int n, t;
    cin >> n >> t;

    vector<int> machines(n);
    for (int i = 0; i < n; i++) {
        cin >> machines[i];
    }

    // max time needed = t * fastest machine
    int low = 1;
    int high = *min_element(machines.begin(), machines.end()) * t;
    int answer = high;

    while (low <= high) {
        int mid = (low + high) / 2;
        if (can_produce(machines, mid, t)) {
            answer = mid;
            high = mid - 1;
        } else {
            low = mid + 1;
        }
    }

    cout << answer << endl;
    return 0;
}
